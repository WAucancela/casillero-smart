# ══════════════════════════════════════════════════════════════
#  .env.example — Copia esto a .env y completa los valores
#  NUNCA subas el .env real a git
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=casilleros
POSTGRES_USER=casilleros_user
POSTGRES_PASSWORD=CAMBIA_ESTO_password_segura_2026

# ── Backend / JWT ────────────────────────────────────────────
SECRET_KEY=CAMBIA_ESTO_clave_jwt_minimo_32_caracteres_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── MQTT / Mosquitto ─────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USER=casilleros
MQTT_PASSWORD=CAMBIA_ESTO_mqtt_password

# ── Biometría ────────────────────────────────────────────────
BIOMETRIC_CONFIDENCE_THRESHOLD=0.75
BIOMETRIC_ENCRYPTION_KEY=CAMBIA_ESTO_fernet_key_base64

# ── Email (notificaciones) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tuempresa.com
SMTP_PASSWORD=CAMBIA_ESTO_app_password
SMTP_FROM=notificaciones@tuempresa.com

# ── App ──────────────────────────────────────────────────────
APP_NAME="Casilleros Automatizados"
DEBUG=false
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost,https://tudominio.com

# ── Puertos externos (nginx) ─────────────────────────────────
HTTP_PORT=8080
HTTPS_PORT=443
